---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ContactForm from './ContactForm.astro';
import type { CollectionEntry } from 'astro:content';
import site from '../data/site.json';

interface Props {
  entry: CollectionEntry<'services'>;
  headingWhite: string;
  headingAccent: string;
  eyebrowLabel?: string;
  ctaEyebrow?: string;
  ctaHeading?: string;
  ctaDescription?: string;
  formId: string;
}

const {
  entry,
  headingWhite,
  headingAccent,
  eyebrowLabel = 'In Practice',
  ctaEyebrow = 'Get in Touch',
  ctaHeading = "Let's Connect",
  ctaDescription = 'Have a campaign, creative project, or role in mind? Send me a message below.',
  formId,
} = Astro.props;

const { data, slug } = entry;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Skills', href: '/services/' },
  { label: data.title }
];

const canonicalUrl = `${site.url}/${slug}/`;

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: data.seoTitle || `${data.title} — ${site.name}`,
  description: data.seoDescription || data.shortDescription,
  url: canonicalUrl,
  about: {
    '@type': 'Person',
    name: site.name,
    url: `${site.url}/`,
    jobTitle: 'Digital Marketing and Visual Marketing Executive',
  },
};
---

<BaseLayout
  title={data.seoTitle || `${data.title} — ${site.name}`}
  description={data.seoDescription || data.shortDescription}
  canonical={canonicalUrl}
  schema={pageSchema}
>
  <section class="page-header">
    <div class="wrap">
      <Breadcrumbs items={breadcrumbs} />
      <span class="eyebrow">{data.tag}</span>
      <h1>{headingWhite} <span style="color:var(--accent);">{headingAccent}</span></h1>
      <p class="section-sub">{data.heroSubtitle || data.shortDescription}</p>
    </div>
  </section>

  <!-- Core Approach -->
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">{eyebrowLabel}</span>
          <h2 style="margin-top:8px;">{data.thesisHeading}</h2>
        </div>
        <p>{data.thesisDescription}</p>
      </div>

      <div class="projects-grid" style="margin-top:40px;">
        {data.capabilities.map((cap, i) => (
          <div class="reveal" style="background:var(--bg-2);border:1px solid var(--border);border-radius:14px;padding:32px;">
            <span class="eyebrow" style="color:var(--accent);">0{i + 1}</span>
            <h3 style="font-size:22px;margin:12px 0 10px;color:var(--text-1);">{cap.title}</h3>
            <p style="color:var(--text-2);font-size:14px;line-height:1.7;">{cap.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Workflow Steps -->
  {data.methodologySteps && data.methodologySteps.length > 0 && (
    <section class="section" style="background:var(--bg-2);">
      <div class="wrap">
        <div class="section-head reveal">
          <div>
            <span class="eyebrow">My Workflow</span>
            <h2 style="margin-top:8px;">{data.methodologyHeading}</h2>
          </div>
          <p>How I plan, execute, and monitor work step by step.</p>
        </div>

        <div class="stats-grid reveal" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));">
          {data.methodologySteps.map((step) => (
            <div class="stat">
              <div class="num" style="font-size:32px;color:var(--accent);">{step.num}</div>
              <div class="lab" style="color:var(--text-1);margin-top:10px;">{step.title}</div>
              <p style="color:var(--text-2);font-size:13px;margin-top:8px;">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <slot />

  <!-- Contact CTA -->
  <section class="section">
    <div class="wrap" style="text-align:center;">
      <span class="eyebrow reveal">{ctaEyebrow}</span>
      <h2 class="reveal" style="margin:16px 0 24px;">{ctaHeading}</h2>
      <p class="reveal" style="color:var(--text-2);max-width:540px;margin:0 auto 40px;">{ctaDescription}</p>
      <ContactForm id={formId} />
    </div>
  </section>
</BaseLayout>
