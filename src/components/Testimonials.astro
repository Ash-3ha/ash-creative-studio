---
interface TestimonialItem {
  name: string;
  role: string;
  company?: string;
  quote: string;
  avatar?: string;
}

interface Props {
  items: TestimonialItem[];
  eyebrowText?: string;
}

const { items, eyebrowText = '09 — Testimonials' } = Astro.props;
---

<section class="section">
  <div class="wrap">
    <div class="eyebrow reveal">{eyebrowText}</div>
    <div class="testi-wrap reveal">
      <div class="testi-mark">"</div>
      <div class="testi-track">
        {items.map((item, index) => (
          <div class:list={['testi-slide', { active: index === 0 }]}>
            <p>{item.quote}</p>
            <div class="testi-foot">
              <div class="testi-avatar">
                {item.avatar && (
                  <img
                    src={item.avatar}
                    alt={item.name}
                    width="44"
                    height="44"
                    loading="lazy"
                    style="border-radius:50%;width:100%;height:100%;object-fit:cover;"
                  />
                )}
              </div>
              <div>
                <div class="testi-name">{item.name}</div>
                <div class="testi-role">{item.role}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="testi-nav">
        <button type="button" class="tnav-btn magnetic" id="tPrev" aria-label="Previous testimonial">←</button>
        <button type="button" class="tnav-btn magnetic" id="tNext" aria-label="Next testimonial">→</button>
      </div>
    </div>
  </div>
</section>
