---
import site from '../data/site.json';

interface Props {
  gtmId?: string;
}

const { gtmId: propGtmId } = Astro.props;

// Priority: 1. PUBLIC_GTM_ID env, 2. GTM_ID env, 3. prop, 4. site.json
const envGtmId = import.meta.env.PUBLIC_GTM_ID || import.meta.env.GTM_ID;
const activeGtmId = envGtmId || propGtmId || site.gtmId;
const isConfigured = activeGtmId && activeGtmId !== 'GTM-XXXXXXX';
---

<!-- Global Google Tag Manager dataLayer & gtag Initialization -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){ window.dataLayer.push(arguments); }
  gtag('js', new Date());
</script>

{/* Official Google Tag Manager Container Script */}
{isConfigured && (
  <script is:inline define:vars={{ activeGtmId }}>
    // Prevent duplicate loading during page navigation
    if (!window.__gtm_installed) {
      window.__gtm_installed = true;
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer',activeGtmId);
    }
  </script>
)}
