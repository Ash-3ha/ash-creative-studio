---
import { getEntry } from 'astro:content';
import SkillPageLayout from '../components/SkillPageLayout.astro';

const entry = await getEntry('services', 'seo-services');
if (!entry) throw new Error('Missing services entry: seo-services');
---

<SkillPageLayout
  entry={entry}
  headingWhite="Website &"
  headingAccent="SEO Fundamentals"
  eyebrowLabel="Web & Search"
  ctaEyebrow="Get in Touch"
  ctaHeading="Want to Discuss Web & SEO Work?"
  ctaDescription="Reach out if you'd like to talk about website updates, landing pages, CMS workflows, or SEO fundamentals."
  formId="seo-contact-form"
/>
