---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import SocialReelsSlider from '../components/SocialReelsSlider.astro';
import ContactForm from '../components/ContactForm.astro';
import site from '../data/site.json';
import home from '../data/home.json';
import { getWhatsAppUrl } from '../utils/whatsapp';

const allProjects = (await getCollection('portfolio'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const featuredProjects = allProjects.slice(0, 6);

const allArticles = (await getCollection('blog'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const featuredArticle = allArticles[0];
const gridArticles = allArticles.slice(1, 4);

const serviceEntries = (await getCollection('services'))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const heroCards = home.heroCards || [];
const toolsList = home.tools?.items || [];
const heroHeadlineParts = (home.hero.headline || 'Building Digital Experiences Through Marketing & Creativity.').split(/(Marketing)/i);

const homeSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: `${site.url}/`,
    name: `${site.name} — Portfolio`,
    description: site.description,
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${site.url}/#person`,
    name: site.name,
    url: `${site.url}/`,
    image: `${site.url}/images/uploads/og-default.svg`,
    jobTitle: 'Digital Marketing and Visual Marketing Executive',
    description: site.description,
    email: site.email,
    telephone: site.phone,
    worksFor: {
      '@type': 'Organization',
      name: 'SPT Hospitals',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Coimbatore',
        addressRegion: 'TN',
        addressCountry: 'IN',
      },
    },
    homeLocation: {
      '@type': 'Place',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Coimbatore',
        addressRegion: 'TN',
        addressCountry: 'IN',
      },
    },
    knowsAbout: [
      'Google Ads',
      'Meta Ads',
      'Performance Marketing',
      'Social Media Marketing',
      'SEO Fundamentals',
      'Google Analytics',
      'Google Tag Manager',
      'Google Search Console',
      'Graphic Design',
      'Video Editing',
      'Website Content Management',
      'Landing Page Development',
    ],
    sameAs: [
      site.social.linkedin !== '#' ? site.social.linkedin : undefined,
      site.social.behance !== '#' ? site.social.behance : undefined,
      site.social.instagram !== '#' ? site.social.instagram : undefined,
      site.social.youtube !== '#' ? site.social.youtube : undefined,
    ].filter(Boolean),
  },
];
---

<BaseLayout
  title={`${site.name} — Digital Marketer & Visual Creative`}
  description={site.description}
  canonical={`${site.url}/`}
  schema={homeSchema}
>
  <!-- ============ HERO ============ -->
  <section class="hero" id="home">
    <div class="wrap hero-copy">
      <div class="eyebrow reveal">{home.hero.eyebrow}</div>
      <h1 class="reveal">
        {heroHeadlineParts.map((part) => (
          part.toLowerCase() === 'marketing' ? <em>{part}</em> : part
        ))}
      </h1>
      <p class="reveal">{home.hero.description}</p>
      <div class="hero-ctas reveal">
        <a href="/portfolio/" class="btn primary magnetic" data-track="primary_cta_click" data-track-location="hero">
          {home.hero.ctaPrimaryLabel} <span class="arrow">→</span>
        </a>
        <a href="/contact/" class="btn ghost magnetic" data-track="book_call_click" data-track-location="hero">
          {home.hero.ctaSecondaryLabel}
        </a>
      </div>
    </div>
    <div class="hero-visual" id="heroVisual" aria-hidden="true">
      <div class="blob b1"></div><div class="blob b2"></div>
      {heroCards.map((card) => (
        <div class={`float-card ${card.id}`} data-depth={card.depth}>
          {card.image && (
            <div class="float-card-media">
              <img src={card.image} alt={card.alt || card.label} loading="eager" />
              <div class="float-card-overlay"></div>
            </div>
          )}
          <span class="float-card-label">{card.label}</span>
        </div>
      ))}
    </div>
    <div class="scroll-cue"><div class="line"><span></span></div>Scroll</div>
  </section>

  <!-- ============ ABOUT ME ============ -->
  <section class="section" id="about">
    <div class="wrap philosophy">
      <div class="philosophy-copy">
        <div class="eyebrow reveal">{home.about.eyebrow}</div>
        <h2 class="reveal">{home.about.headline} <span class="light">{home.about.lightHeadline}</span></h2>
        <div class="philosophy-body reveal">
          <p>{home.about.paragraph1}</p>
          <p>{home.about.paragraph2}</p>
        </div>
        <div class="timeline-vmv reveal">
          <div><div class="eyebrow">Current Role</div><span style="font-size:13px;color:var(--text-2);">{home.about.roleSummary}</span></div>
          <div><div class="eyebrow">Focus</div><span style="font-size:13px;color:var(--text-2);">{home.about.focusSummary}</span></div>
          <div><div class="eyebrow">Direction</div><span style="font-size:13px;color:var(--text-2);">{home.about.goalSummary}</span></div>
        </div>
        <div class="reveal" style="margin-top:32px;">
          <a href="/about/" class="btn ghost magnetic">Read Full Bio &amp; Journey →</a>
        </div>
      </div>
      <div class="studio-portrait reveal">
        <span class="cap">{home.about.portraitCaption}</span>
      </div>
    </div>
  </section>

  <!-- ============ SKILLS & EXPERTISE ============ -->
  <section class="section" id="skills">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">03 — Skills &amp; Expertise</span>
          <h2 style="margin-top:8px;">What I Bring to the Table</h2>
        </div>
        <p>Four connected skill areas spanning paid acquisition, tracking, visual production, and web updates.</p>
      </div>

      <div class="skills-grid">
        {home.skillGroups.map((group) => (
          <div class="skill-pillar-card reveal">
            <div>
              <span class="eyebrow">{group.num}</span>
              <h3>{group.title}</h3>
              <p>{group.summary}</p>
              <div class="skill-chips">
                {group.items.map((skill) => (
                  <span class="skill-chip">{skill}</span>
                ))}
              </div>
            </div>
            <div>
              <a href={group.linkHref} style="font-family:var(--mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--accent);">
                {group.linkLabel} →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FEATURED PROJECTS ============ -->
  <section class="section" id="portfolio">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">04 — Selected Work</span>
          <h2 style="margin-top:8px;">My Portfolio</h2>
        </div>
        <p>Personal projects, professional work, and collaborative initiatives across marketing, content, design, video, and web.</p>
      </div>
      <div class="projects-grid">
        {featuredProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            category={`${project.data.projectType} • ${project.data.category}`}
            year={project.data.year}
            slug={project.slug}
            gradientFrom={project.data.gradientFrom}
            gradientTo={project.data.gradientTo}
            featuredImage={project.data.featuredImage}
          />
        ))}
      </div>
      <div style="text-align:center;margin-top:60px;" class="reveal">
        <a href="/portfolio/" class="btn ghost magnetic">View All Work ({allProjects.length})</a>
      </div>
    </div>
  </section>

  <!-- ============ EXPERIENCE ============ -->
  <section class="section" id="experience" style="background:var(--bg-2);">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">{home.experience.eyebrow}</span>
          <h2 style="margin-top:8px;">{home.experience.headline}</h2>
        </div>
        <p>{home.experience.subtitle}</p>
      </div>

      <div class="exp-card reveal">
        <div class="exp-header">
          <div>
            <span class="eyebrow">{home.experience.duration}</span>
            <h3 style="font-size:clamp(22px,2.6vw,32px);margin-top:8px;">{home.experience.roleTitle}</h3>
            <p style="color:var(--text-2);font-size:15px;margin-top:4px;">{home.experience.organization}</p>
          </div>
          <a href="/about/" class="btn ghost" style="padding:12px 22px;">More About Me →</a>
        </div>

        <p style="color:var(--text-2);font-size:14px;line-height:1.7;margin-top:22px;max-width:780px;">
          {home.experience.overview}
        </p>

        <div class="exp-grid">
          <div>
            <span class="eyebrow">{home.experience.individualTitle}</span>
            <ul class="exp-list">
              {home.experience.individualItems.map((item) => (
                <li><span>{item}</span></li>
              ))}
            </ul>
          </div>
          <div>
            <span class="eyebrow">{home.experience.collaborativeTitle}</span>
            <ul class="exp-list">
              {home.experience.collaborativeItems.map((item) => (
                <li><span>{item}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FOCUS AREAS ============ -->
  <section class="section" id="services">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">06 — Deep Dives</span>
          <h2 style="margin-top:8px;">Areas I Focus On</h2>
        </div>
        <p>Detailed breakdowns of how I approach campaigns, tracking, visual content, and website updates.</p>
      </div>

      <div>
        {serviceEntries.map((svc, i) => (
          <div class="svc-row reveal">
            <div class="svc-media" data-tag={svc.data.tag}></div>
            <div class="svc-body">
              <span class="eyebrow">{String(i + 1).padStart(2, '0')}</span>
              <h3>{svc.data.title}</h3>
              <p style="color:var(--text-2);font-size:14px;">{svc.data.shortDescription}</p>
              {svc.data.capabilities && svc.data.capabilities.length > 0 && (
                <ul>
                  {svc.data.capabilities.slice(0, 3).map((cap) => (
                    <li>{cap.title}</li>
                  ))}
                </ul>
              )}
              <a href={`/${svc.slug}/`} class="btn ghost" style="margin-top:16px;">
                Explore {svc.data.title} →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ TOOLS & PLATFORMS ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">{home.tools.eyebrow}</span>
          <h2 style="margin-top:8px;">{home.tools.headline}</h2>
        </div>
        <p>{home.tools.subtitle}</p>
      </div>
      <div class="soft-wall reveal">
        {toolsList.map((tool) => (
          <div class:list={['soft-tag', tool.size]}>{tool.name}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ NOTES & BLOG ============ -->
  <section class="section" id="blog" style="background:var(--bg-2);">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">08 — Writing &amp; Notes</span>
          <h2 style="margin-top:8px;">Insights &amp; Learnings</h2>
        </div>
        <p>Practical notes on digital marketing, tracking setups, visual content, and web fundamentals.</p>
      </div>

      {featuredArticle && (
        <a href={`/blog/${featuredArticle.slug}/`} class="blog-feature reveal" style="text-decoration:none;display:grid;">
          <div class="proj-media" style="--proj-c1:#211a26;--proj-c2:#0a0a0a;">
            {featuredArticle.data.featuredImage && (
              <img src={featuredArticle.data.featuredImage} alt={featuredArticle.data.title} />
            )}
            <div class="proj-info"><span class="eyebrow">Featured Note</span></div>
          </div>
          <div>
            <span class="eyebrow">{featuredArticle.data.category}</span>
            <h3 style="font-size:clamp(22px,2.5vw,32px);margin-top:12px;color:var(--text-1);">{featuredArticle.data.title}</h3>
            <p style="color:var(--text-2);font-size:14px;margin-top:16px;">{featuredArticle.data.excerpt}</p>
            <div class="tag-row">
              {featuredArticle.data.tags.map(tag => (
                <span>{tag}</span>
              ))}
            </div>
          </div>
        </a>
      )}

      <div class="blog-grid">
        {gridArticles.map((article) => (
          <BlogCard
            title={article.data.title}
            category={article.data.category}
            slug={article.slug}
            featuredImage={article.data.featuredImage}
          />
        ))}
      </div>

      <div style="text-align:center;margin-top:60px;" class="reveal">
        <a href="/blog/" class="btn ghost magnetic">View All Notes ({allArticles.length})</a>
      </div>
    </div>
  </section>

  <!-- ============ SOCIAL REELS & SHORTS SLIDER ============ -->
  {home.socialReels && (
    <SocialReelsSlider
      eyebrow={home.socialReels.eyebrow}
      headline={home.socialReels.headline}
      subtitle={home.socialReels.subtitle}
      items={home.socialReels.items}
    />
  )}

  <!-- ============ CONTACT ============ -->
  <section class="contact-section section" id="contact">
    <div class="wrap">
      <div class="eyebrow reveal">10 — Get in Touch</div>
      <h2 class="reveal">Let's work together.</h2>

      <ContactForm id="home-contact-form" />

      <div class="social-row reveal">
        <a href={getWhatsAppUrl(site.whatsapp)} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-track-location="home_contact_section" class="magnetic">WhatsApp</a>
        <a href={`mailto:${site.email}`} data-track="email_click" data-track-location="home_contact_section" class="magnetic">Email</a>
        <a href={`tel:${site.phone.replace(/[^\d+]/g, '')}`} data-track="phone_click" data-track-location="home_contact_section" class="magnetic">Call</a>
        {site.social.linkedin !== '#' && <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" class="magnetic">LinkedIn</a>}
        {site.social.behance !== '#' && <a href={site.social.behance} target="_blank" rel="noopener noreferrer" class="magnetic">Behance</a>}
        {site.social.instagram !== '#' && <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" class="magnetic">Instagram</a>}
        {site.social.youtube !== '#' && <a href={site.social.youtube} target="_blank" rel="noopener noreferrer" class="magnetic">YouTube</a>}
      </div>
    </div>
  </section>
</BaseLayout>
