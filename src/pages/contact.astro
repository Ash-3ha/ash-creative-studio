---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactForm from '../components/ContactForm.astro';
import site from '../data/site.json';
import { getWhatsAppUrl, formatWhatsAppDisplay } from '../utils/whatsapp';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Contact' }
];

const whatsappHref = getWhatsAppUrl(
  site.whatsapp,
  'Hello ASH Creative Studio, I would like to discuss a new project brief.'
);
const cleanPhone = site.phone.replace(/[^\d+]/g, '');

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact & Project Inquiries — ${site.name}`,
  description: 'Initiate a project with ASH Creative Studio. Tell us about your brand vision, scope, and timeline, and we will get back within 24 business hours.',
  url: `${site.url}/contact/`,
  mainEntity: {
    '@type': 'ProfessionalService',
    name: site.name,
    url: `${site.url}/`,
    email: site.email,
    telephone: site.phone,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Mumbai',
      addressCountry: 'IN',
    },
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: site.phone,
      contactType: 'customer support',
      availableLanguage: ['English', 'Hindi'],
    },
  },
};
---

<BaseLayout
  title={`Contact & Project Inquiries — ${site.name}`}
  description="Initiate a project with ASH Creative Studio. Tell us about your brand vision, scope, and timeline, and we will get back within 24 business hours."
  canonical={`${site.url}/contact/`}
  schema={contactSchema}
>
  <section class="page-header">
    <div class="wrap">
      <Breadcrumbs items={breadcrumbs} />
      <span class="eyebrow">Direct Contact</span>
      <h1>Let's Build Something <span style="color:var(--accent);">Extraordinary.</span></h1>
      <p class="section-sub">We review all project briefs within 24 business hours. Tell us about your goals, timeline, and current challenges.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap contact-grid">
      <!-- Main Form -->
      <div>
        <span class="eyebrow reveal" style="margin-bottom:16px;">Project Brief</span>
        <h2 class="reveal" style="font-size:32px;margin-bottom:32px;">Send an Enquiry</h2>
        <ContactForm id="contact-page-form" />
      </div>

      <!-- Direct Channels & Office Info -->
      <div class="direct-channels-card reveal">
        <span class="eyebrow" style="color:var(--accent);">Direct Channels</span>
        <h3 style="font-size:24px;margin:12px 0 24px;color:var(--text-1);">Prefer a Direct Conversation?</h3>
        <p style="color:var(--text-2);font-size:14px;line-height:1.7;margin-bottom:32px;">
          Reach out directly via WhatsApp, email, or telephone for expedited project discovery or partnership discussions.
        </p>

        <div style="display:flex;flex-direction:column;gap:16px;">
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="btn ghost magnetic"
            data-track="whatsapp_click"
            data-track-location="contact_page_card"
            style="justify-content:flex-start;width:100%;"
          >
            <span style="color:#25D366;font-size:18px;">💬</span>
            <span>WhatsApp Us ({formatWhatsAppDisplay(site.whatsapp)})</span>
          </a>

          <a
            href={`mailto:${site.email}`}
            class="btn ghost magnetic"
            data-track="email_click"
            data-track-location="contact_page_card"
            style="justify-content:flex-start;width:100%;"
          >
            <span style="color:var(--accent);font-size:18px;">✉️</span>
            <span>{site.email}</span>
          </a>

          <a
            href={`tel:${cleanPhone}`}
            class="btn ghost magnetic"
            data-track="phone_click"
            data-track-location="contact_page_card"
            style="justify-content:flex-start;width:100%;"
          >
            <span style="color:var(--accent);font-size:18px;">📞</span>
            <span>{site.phone}</span>
          </a>
        </div>

        <div style="margin-top:40px;padding-top:24px;border-top:1px solid var(--border);">
          <div class="eyebrow" style="margin-bottom:8px;">Studio Location</div>
          <p style="font-size:14px;color:var(--text-1);">{site.address}</p>
        </div>

        <div style="margin-top:24px;padding-top:24px;border-top:1px solid var(--border);">
          <div class="eyebrow" style="margin-bottom:12px;">Social Networks</div>
          <div style="display:flex;flex-wrap:wrap;gap:16px;">
            {site.social.linkedin !== '#' && <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" style="font-family:var(--mono);font-size:11px;color:var(--text-2);text-transform:uppercase;">LinkedIn</a>}
            {site.social.behance !== '#' && <a href={site.social.behance} target="_blank" rel="noopener noreferrer" style="font-family:var(--mono);font-size:11px;color:var(--text-2);text-transform:uppercase;">Behance</a>}
            {site.social.artstation !== '#' && <a href={site.social.artstation} target="_blank" rel="noopener noreferrer" style="font-family:var(--mono);font-size:11px;color:var(--text-2);text-transform:uppercase;">ArtStation</a>}
            {site.social.instagram !== '#' && <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" style="font-family:var(--mono);font-size:11px;color:var(--text-2);text-transform:uppercase;">Instagram</a>}
            {site.social.youtube !== '#' && <a href={site.social.youtube} target="_blank" rel="noopener noreferrer" style="font-family:var(--mono);font-size:11px;color:var(--text-2);text-transform:uppercase;">YouTube</a>}
            {site.social.linkedin === '#' && <span style="font-family:var(--mono);font-size:11px;color:var(--text-2);text-transform:uppercase;">LinkedIn</span>}
            {site.social.behance === '#' && <span style="font-family:var(--mono);font-size:11px;color:var(--text-2);text-transform:uppercase;">Behance</span>}
            {site.social.instagram === '#' && <span style="font-family:var(--mono);font-size:11px;color:var(--text-2);text-transform:uppercase;">Instagram</span>}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 64px;
    align-items: start;
  }

  .direct-channels-card {
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 40px;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .direct-channels-card {
      padding: 28px;
    }
  }
</style>
