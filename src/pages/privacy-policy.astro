---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import site from '../data/site.json';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Privacy Policy' }
];

const privacyPolicySchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `Privacy Policy — ${site.name}`,
  description: 'Read the ASH Creative Studio privacy policy detailing data protection, cookie usage, analytics tracking, and user rights.',
  url: `${site.url}/privacy-policy/`,
  inLanguage: 'en-US',
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
  },
};
---

<BaseLayout
  title={`Privacy Policy — ${site.name}`}
  description="Read the ASH Creative Studio privacy policy detailing data protection, cookie usage, analytics tracking, and user rights."
  canonical={`${site.url}/privacy-policy/`}
  noindex={false}
  schema={privacyPolicySchema}
>
  <section class="page-header">
    <div class="wrap">
      <Breadcrumbs items={breadcrumbs} />
      <span class="eyebrow">Legal &amp; Compliance</span>
      <h1>Privacy <span style="color:var(--accent);">Policy</span></h1>
      <p class="section-sub">How we handle, safeguard, and process your information across our website and digital services.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <article class="legal-content">
        <div style="background:rgba(255,106,0,0.08);border:1px solid var(--accent);border-radius:8px;padding:16px 20px;color:var(--accent);font-family:var(--mono);font-size:12px;margin-bottom:36px;">
          [TEMPLATE — REVIEW WITH YOUR LEGAL COUNSEL BEFORE COMMERCIAL DEPLOYMENT]
        </div>

        <p><strong>Effective Date:</strong> January 1, 2026</p>
        <p>
          {site.name} ("we", "our", or "the Studio") respects your personal privacy. This Privacy Policy details the types of personal and analytical information we collect through our public website (<a href={site.url}>{site.url}</a>), how that information is utilized, and your choices regarding data privacy.
        </p>

        <h2>1. Information We Collect</h2>
        <h3>A. Information You Voluntarily Provide</h3>
        <p>When you submit an inquiry through our contact form or contact us via email, telephone, or messaging applications, we may collect:</p>
        <ul>
          <li>Full name and corporate title</li>
          <li>Corporate and personal email address</li>
          <li>Telephone / WhatsApp contact number</li>
          <li>Estimated budget and project scope specifications</li>
          <li>Any contextual details included in your project brief</li>
        </ul>

        <h3>B. Technical &amp; Usage Information Collected Automatically</h3>
        <p>When you browse our website, our hosting providers and tracking tags may automatically log:</p>
        <ul>
          <li>IP address and approximate geographic location</li>
          <li>Browser type, device classification, and operating system</li>
          <li>Referring URLs, pages viewed, and session durations</li>
          <li>Interaction events (e.g., button clicks, navigation toggles)</li>
        </ul>

        <h2>2. How We Utilize Collected Information</h2>
        <p>We process collected data exclusively for legitimate commercial purposes:</p>
        <ul>
          <li>Reviewing project inquiries and preparing bespoke service proposals</li>
          <li>Direct communication regarding active engagements or consultation requests</li>
          <li>Analyzing website interaction velocity to optimize site performance and design</li>
          <li>Preventing spam submissions and unauthorized automated scraping</li>
        </ul>

        <h2>3. Tag Management &amp; Analytics Architecture</h2>
        <p>We implement a consolidated tracking setup via Google Tag Manager (GTM):</p>
        <ul>
          <li><strong>Google Tag Manager:</strong> Orchestrates script loading based on user consent without duplicate telemetry injection.</li>
          <li><strong>Google Analytics 4 (GA4):</strong> Aggregated traffic and conversion performance reporting.</li>
          <li><strong>Meta Pixel &amp; Conversions API:</strong> Measurement of paid social ad effectiveness and attribution.</li>
        </ul>

        <h2>4. Data Retention &amp; Security</h2>
        <p>
          We employ HTTPS transport layer security (TLS) across all website assets. Inquiries submitted via Netlify Forms are stored in encrypted environments accessible solely to authorized studio administrators. We do not sell, rent, or lease personal customer data to any third-party marketing broker.
        </p>

        <h2>5. Your Statutory Rights</h2>
        <p>Depending on your jurisdiction, you have the right to:</p>
        <ul>
          <li>Request a copy of personal information stored about you</li>
          <li>Request rectification of inaccurate contact data</li>
          <li>Request permanent deletion of your inquiry data from our records</li>
        </ul>

        <h2>6. Contact Regarding Privacy</h2>
        <p>For any questions regarding this policy or data inquiries, contact our studio data controller:</p>
        <ul>
          <li><strong>Email:</strong> <a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><strong>Phone:</strong> <a href={`tel:${site.phone}`}>{site.phone}</a></li>
          <li><strong>Address:</strong> {site.address}</li>
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>
