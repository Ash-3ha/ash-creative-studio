---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import site from '../data/site.json';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Privacy Policy' }
];

const privacyPolicySchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `Privacy Policy — ${site.name}`,
  description: `Privacy policy for ${site.name}'s personal portfolio website detailing contact submissions, analytics tracking, and user rights.`,
  url: `${site.url}/privacy-policy/`,
  inLanguage: 'en-US',
  author: {
    '@type': 'Person',
    name: site.name,
    url: site.url,
  },
};
---

<BaseLayout
  title={`Privacy Policy — ${site.name}`}
  description={`Privacy policy for ${site.name}'s personal portfolio website detailing contact submissions, analytics tracking, and user rights.`}
  canonical={`${site.url}/privacy-policy/`}
  noindex={false}
  schema={privacyPolicySchema}
>
  <section class="page-header">
    <div class="wrap">
      <Breadcrumbs items={breadcrumbs} />
      <span class="eyebrow">Site Information</span>
      <h1>Privacy <span style="color:var(--accent);">Policy</span></h1>
      <p class="section-sub">How information submitted on my personal portfolio website is handled and protected.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <article class="legal-content">
        <p><strong>Effective Date:</strong> January 1, 2026</p>
        <p>
          This personal portfolio website (<a href={site.url}>{site.url}</a>) is operated by {site.name}. I respect your privacy and keep data collection limited to what is needed to respond to messages and understand basic site traffic.
        </p>

        <h2>1. Information Collected</h2>
        <h3>A. Information You Provide Voluntarily</h3>
        <p>When you submit the contact form or reach out via email, phone, or WhatsApp, I may receive:</p>
        <ul>
          <li>Your name and contact details (email address, phone/WhatsApp number)</li>
          <li>Optional organization or timeline details you enter</li>
          <li>The message you choose to send</li>
        </ul>

        <h3>B. Basic Analytics &amp; Technical Data</h3>
        <p>When you browse this site, standard hosting logs and analytics tools may record:</p>
        <ul>
          <li>Browser type, device category, and general geographic region</li>
          <li>Pages visited, referral source, and basic interaction events (such as button or contact clicks)</li>
        </ul>

        <h2>2. How This Information Is Used</h2>
        <p>I use submitted and aggregated analytics information solely to:</p>
        <ul>
          <li>Reply to your message, role enquiry, or collaboration request</li>
          <li>Understand how visitors navigate the portfolio and fix usability or tracking issues</li>
          <li>Prevent automated form spam</li>
        </ul>

        <h2>3. Tag Management &amp; Analytics Tools</h2>
        <p>This website uses Google Tag Manager (GTM) and Google Analytics 4 (GA4) to understand traffic patterns and verify tracking setups.</p>

        <h2>4. Data Security &amp; Retention</h2>
        <p>
          All pages are served over HTTPS. Contact form entries submitted through Netlify Forms are only accessible to me as the site owner. I do not sell, rent, or trade contact details with third parties.
        </p>

        <h2>5. Your Rights</h2>
        <p>You may contact me at any time to request access to, correction of, or deletion of personal contact details you submitted through the form.</p>

        <h2>6. Contact</h2>
        <p>For any questions about this policy or data removal requests, reach me directly:</p>
        <ul>
          <li><strong>Email:</strong> <a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><strong>Phone:</strong> <a href={`tel:${site.phone}`}>{site.phone}</a></li>
          <li><strong>Location:</strong> {site.address}</li>
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>
