---
import { getEntry } from 'astro:content';
import SkillPageLayout from '../components/SkillPageLayout.astro';

const entry = await getEntry('services', 'creative-design');
if (!entry) throw new Error('Missing services entry: creative-design');
---

<SkillPageLayout
  entry={entry}
  headingWhite="Graphic &"
  headingAccent="Creative Design"
  eyebrowLabel="Visual Communication"
  ctaEyebrow="Get in Touch"
  ctaHeading="Let's Work Together"
  ctaDescription="Feel free to message me about visual design, campaign creatives, or portfolio collaborations."
  formId="creative-contact-form"
/>
