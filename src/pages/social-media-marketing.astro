---
import { getEntry } from 'astro:content';
import SkillPageLayout from '../components/SkillPageLayout.astro';

const entry = await getEntry('services', 'social-media-marketing');
if (!entry) throw new Error('Missing services entry: social-media-marketing');
---

<SkillPageLayout
  entry={entry}
  headingWhite="Social Media"
  headingAccent="Marketing"
  eyebrowLabel="Content & Channels"
  ctaEyebrow="Get in Touch"
  ctaHeading="Let's Connect"
  ctaDescription="Reach out to discuss social media content planning, visual posts, or digital marketing roles."
  formId="social-contact-form"
/>
