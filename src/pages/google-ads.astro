---
import { getEntry } from 'astro:content';
import SkillPageLayout from '../components/SkillPageLayout.astro';

const entry = await getEntry('services', 'google-ads');
if (!entry) throw new Error('Missing services entry: google-ads');
---

<SkillPageLayout
  entry={entry}
  headingWhite="Google"
  headingAccent="Ads"
  eyebrowLabel="Paid Search"
  ctaEyebrow="Get in Touch"
  ctaHeading="Want to Talk About Google Ads?"
  ctaDescription="Feel free to message me regarding campaign setups, search strategy, or marketing opportunities."
  formId="google-ads-contact-form"
/>
