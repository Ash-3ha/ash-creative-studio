---
import { getEntry } from 'astro:content';
import SkillPageLayout from '../components/SkillPageLayout.astro';

const entry = await getEntry('services', 'meta-ads');
if (!entry) throw new Error('Missing services entry: meta-ads');
---

<SkillPageLayout
  entry={entry}
  headingWhite="Meta"
  headingAccent="Ads"
  eyebrowLabel="Paid Social"
  ctaEyebrow="Get in Touch"
  ctaHeading="Interested in Collaborating on Paid Social?"
  ctaDescription="Reach out if you'd like to discuss Meta Ads campaigns, visual ad creatives, or team opportunities."
  formId="meta-ads-contact-form"
/>
