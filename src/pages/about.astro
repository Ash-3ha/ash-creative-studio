---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import site from '../data/site.json';
import home from '../data/home.json';
import about from '../data/about.json';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'About Me' }
];

const tools = home.tools?.items || [];
const exp = home.experience;

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `About Me — ${site.name}`,
  description: about.intro,
  url: `${site.url}/about/`,
  mainEntity: {
    '@type': 'Person',
    name: site.name,
    url: `${site.url}/`,
    jobTitle: exp.roleTitle,
    worksFor: {
      '@type': 'Organization',
      name: exp.organization,
    },
    description: site.description,
    telephone: site.phone,
    email: site.email,
  },
};
---

<BaseLayout
  title={`About Me — ${site.name}`}
  description={about.intro}
  canonical={`${site.url}/about/`}
  schema={aboutSchema}
>
  <section class="page-header">
    <div class="wrap">
      <Breadcrumbs items={breadcrumbs} />
      <span class="eyebrow">{about.eyebrow}</span>
      <h1>{about.headlineStart} <span style="color:var(--accent);">{about.headlineAccent}</span></h1>
      <p class="section-sub">{about.intro}</p>
    </div>
  </section>

  <!-- Personal Approach Summary -->
  <section class="section" id="philosophy">
    <div class="wrap philosophy">
      <div class="philosophy-copy">
        <div class="eyebrow reveal">My Approach</div>
        <h2 class="reveal">{home.about.headline} <span class="light">{home.about.lightHeadline}</span></h2>
        <div class="philosophy-body reveal">
          {about.approachParagraphs.map((para) => (
            <p>{para}</p>
          ))}
        </div>
        <div class="timeline-vmv reveal">
          <div><div class="eyebrow">Current Role</div><span style="font-size:13px;color:var(--text-2);">{home.about.roleSummary}</span></div>
          <div><div class="eyebrow">Focus</div><span style="font-size:13px;color:var(--text-2);">{home.about.focusSummary}</span></div>
          <div><div class="eyebrow">{about.goalsTitle}</div><span style="font-size:13px;color:var(--text-2);">{about.goalsText}</span></div>
        </div>
      </div>
      <div class="studio-portrait reveal">
        <span class="cap">{home.about.portraitCaption}</span>
      </div>
    </div>
  </section>

  <!-- Journey & Background -->
  <section class="section" style="background:var(--bg-2);">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">Background</span>
          <h2 style="margin-top:8px;">{about.journeyHeading}</h2>
        </div>
        <p>6–12 months of focused execution across paid media, tracking, creative visuals, and web updates.</p>
      </div>

      <div style="max-width:760px;color:var(--text-2);font-size:16px;line-height:1.8;" class="reveal">
        {about.journeyParagraphs.map((para, idx) => (
          <p style={idx < about.journeyParagraphs.length - 1 ? 'margin-bottom:20px;' : ''}>{para}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- Current Experience -->
  <section class="section" id="experience">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">Experience</span>
          <h2 style="margin-top:8px;">{exp.organization}</h2>
        </div>
        <p>{exp.duration}</p>
      </div>

      <div class="exp-card reveal">
        <h3 style="font-size:26px;">{exp.roleTitle}</h3>
        <p style="color:var(--text-2);font-size:15px;line-height:1.7;margin-top:12px;max-width:760px;">
          {exp.overview}
        </p>

        <div class="exp-grid">
          <div>
            <span class="eyebrow">{exp.individualTitle}</span>
            <ul class="exp-list">
              {exp.individualItems.map((item) => (
                <li><span>{item}</span></li>
              ))}
            </ul>
          </div>
          <div>
            <span class="eyebrow">{exp.collaborativeTitle}</span>
            <ul class="exp-list">
              {exp.collaborativeItems.map((item) => (
                <li><span>{item}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tools & Platforms -->
  <section class="section" style="background:var(--bg-2);">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">Platforms &amp; Tools</span>
          <h2 style="margin-top:8px;">{home.tools.headline}</h2>
        </div>
        <p>{home.tools.subtitle}</p>
      </div>
      <div class="soft-wall reveal">
        {tools.map((t) => (
          <div class:list={['soft-tag', t.size]}>{t.name}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- How I Work -->
  <section class="section" id="process">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">Workflow</span>
          <h2 style="margin-top:8px;">{about.workflowHeading}</h2>
        </div>
        <p>{about.workflowSubtitle}</p>
      </div>

      <div class="process-wrap reveal">
        <div class="process-track" id="processTrack">
          <div class="process-line"><div class="process-line-fill" id="processFill"></div></div>
          {about.workflowSteps.map((step) => (
            <div class="p-step">
              <div class="p-dot"></div>
              <span class="eyebrow">{step.num}</span>
              <h4>{step.title}</h4>
              <p style="color:var(--text-2);font-size:12px;margin-top:6px;line-height:1.5;">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section" style="background:var(--bg-2);">
    <div class="wrap" style="text-align:center;">
      <span class="eyebrow reveal">Connect</span>
      <h2 class="reveal" style="margin:16px 0 20px;">Let's Work Together</h2>
      <p class="reveal" style="color:var(--text-2);max-width:540px;margin:0 auto 36px;">If you're looking for someone who bridges performance marketing, tracking, and visual content, I'd be glad to connect.</p>
      <div class="reveal" style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="/portfolio/" class="btn ghost magnetic">Explore My Work</a>
        <a href="/contact/" class="btn primary magnetic" data-track="primary_cta_click" data-track-location="about_bottom">
          Let's Connect <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
