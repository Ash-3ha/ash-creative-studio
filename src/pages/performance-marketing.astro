---
import { getEntry } from 'astro:content';
import SkillPageLayout from '../components/SkillPageLayout.astro';

const entry = await getEntry('services', 'performance-marketing');
if (!entry) throw new Error('Missing services entry: performance-marketing');
---

<SkillPageLayout
  entry={entry}
  headingWhite="Performance"
  headingAccent="Marketing"
  eyebrowLabel="Paid Growth"
  ctaEyebrow="Let's Connect"
  ctaHeading="Want to Discuss a Campaign?"
  ctaDescription="Reach out if you'd like to talk about Google Ads, Meta Ads, tracking setup, or a digital marketing role."
  formId="perf-contact-form"
>
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">Related Focus Areas</span>
          <h2 style="margin-top:8px;">Core Platforms &amp; Measurement</h2>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px;">
        <a href="/google-ads/" class="reveal" style="display:block;padding:28px;background:var(--glass);border:1px solid var(--border);border-radius:12px;text-decoration:none;">
          <span class="eyebrow">Search Intent</span>
          <h3 style="font-size:20px;margin:8px 0;color:var(--text-1);">Google Ads →</h3>
          <p style="color:var(--text-2);font-size:13px;">Search campaigns, keyword targeting, negative keywords, and landing-page alignment.</p>
        </a>
        <a href="/meta-ads/" class="reveal" style="display:block;padding:28px;background:var(--glass);border:1px solid var(--border);border-radius:12px;text-decoration:none;">
          <span class="eyebrow">Paid Social</span>
          <h3 style="font-size:20px;margin:8px 0;color:var(--text-1);">Meta Ads →</h3>
          <p style="color:var(--text-2);font-size:13px;">Facebook and Instagram campaigns supported by graphic creatives and 9:16 video edits.</p>
        </a>
        <a href="/analytics-tracking/" class="reveal" style="display:block;padding:28px;background:var(--glass);border:1px solid var(--border);border-radius:12px;text-decoration:none;">
          <span class="eyebrow">Measurement</span>
          <h3 style="font-size:20px;margin:8px 0;color:var(--text-1);">Analytics &amp; Tracking →</h3>
          <p style="color:var(--text-2);font-size:13px;">Google Analytics, Google Tag Manager, conversion tracking, and lead monitoring.</p>
        </a>
      </div>
    </div>
  </section>
</SkillPageLayout>
