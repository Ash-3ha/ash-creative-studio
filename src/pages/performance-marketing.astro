---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactForm from '../components/ContactForm.astro';
import { getEntry } from 'astro:content';
import site from '../data/site.json';

const service = await getEntry('services', 'performance-marketing');
const { data } = service;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: data.title }
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: data.title,
  serviceType: data.tag || 'Performance Marketing',
  description: data.seoDescription || data.shortDescription,
  url: `${site.url}/performance-marketing/`,
  provider: {
    '@type': 'ProfessionalService',
    name: site.name,
    url: `${site.url}/`,
    email: site.email,
    telephone: site.phone,
  },
  areaServed: 'Worldwide',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `${data.title} Capabilities`,
    itemListElement: (data.capabilities || []).map((cap) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: cap.title,
        description: cap.desc,
      },
    })),
  },
};
---

<BaseLayout
  title={data.seoTitle || `${data.title} — ${site.name}`}
  description={data.seoDescription || data.shortDescription}
  canonical={`${site.url}/performance-marketing/`}
  schema={serviceSchema}
>
  <section class="page-header">
    <div class="wrap">
      <Breadcrumbs items={breadcrumbs} />
      <span class="eyebrow">{data.tag}</span>
      <h1>Performance <span style="color:var(--accent);">Marketing</span></h1>
      <p class="section-sub">{data.heroSubtitle || data.shortDescription}</p>
    </div>
  </section>

  <!-- Core Thesis -->
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">The Intersection</span>
          <h2 style="margin-top:8px;">{data.thesisHeading}</h2>
        </div>
        <p>{data.thesisDescription}</p>
      </div>

      <div class="projects-grid" style="margin-top:40px;">
        {data.capabilities.map((cap, i) => (
          <div class="reveal" style="background:var(--bg-2);border:1px solid var(--border);border-radius:14px;padding:32px;">
            <span class="eyebrow" style="color:var(--accent);">0{i + 1}</span>
            <h3 style="font-size:22px;margin:12px 0 10px;color:var(--text-1);">{cap.title}</h3>
            <p style="color:var(--text-2);font-size:14px;line-height:1.7;">{cap.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section" style="background:var(--bg-2);">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">The Flywheel</span>
          <h2 style="margin-top:8px;">{data.methodologyHeading}</h2>
        </div>
        <p>Our optimization sprint ensures continuous performance compounding.</p>
      </div>

      <div class="stats-grid reveal" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));">
        {data.methodologySteps.map((step) => (
          <div class="stat">
            <div class="num" style="font-size:36px;color:var(--accent);">{step.num}</div>
            <div class="lab" style="color:var(--text-1);margin-top:10px;">{step.title}</div>
            <p style="color:var(--text-2);font-size:13px;margin-top:8px;">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Dedicated Sub-Services Quick Links -->
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">Deep Dives</span>
          <h2 style="margin-top:8px;">Specialized Ad Channels</h2>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;">
        <a href="/google-ads/" class="reveal" style="display:block;padding:28px;background:var(--glass);border:1px solid var(--border);border-radius:12px;text-decoration:none;">
          <span class="eyebrow">Pillar</span>
          <h3 style="font-size:20px;margin:8px 0;color:var(--text-1);">Google Ads Services →</h3>
          <p style="color:var(--text-2);font-size:13px;">Capture high-intent search traffic with Performance Max, Search, and Shopping campaigns.</p>
        </a>
        <a href="/meta-ads/" class="reveal" style="display:block;padding:28px;background:var(--glass);border:1px solid var(--border);border-radius:12px;text-decoration:none;">
          <span class="eyebrow">Pillar</span>
          <h3 style="font-size:20px;margin:8px 0;color:var(--text-1);">Meta Ads Services →</h3>
          <p style="color:var(--text-2);font-size:13px;">Scale paid social on Facebook and Instagram with compelling motion and dynamic creative.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="wrap" style="text-align:center;">
      <span class="eyebrow reveal">Initiate Campaign</span>
      <h2 class="reveal" style="margin:16px 0 24px;">Ready to Scale Your Acquisition?</h2>
      <p class="reveal" style="color:var(--text-2);max-width:540px;margin:0 auto 40px;">Request a strategic marketing audit. We review your historical account metrics and outline high-impact growth vectors.</p>
      <ContactForm id="perf-contact-form" />
    </div>
  </section>
</BaseLayout>
