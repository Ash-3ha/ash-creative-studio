---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import site from '../../data/site.json';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Portfolio' }
];

const allProjects = (await getCollection('portfolio'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const categoryOrder = [
  'All',
  'Performance Marketing',
  'Social Media',
  'Graphic Design',
  'Video Editing',
  'Website Projects',
];

const categories = categoryOrder.filter(
  (c) => c === 'All' || allProjects.some((p) => p.data.category === c)
);

const portfolioSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Portfolio & Work — ${site.name}`,
  description: 'Selected personal, professional, and collaborative projects by Akash Thirumal across performance marketing, social media, graphic design, video editing, and website projects.',
  url: `${site.url}/portfolio/`,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: allProjects.map((proj, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: proj.data.title,
      url: `${site.url}/portfolio/${proj.slug}/`,
      description: proj.data.overview,
      image: proj.data.featuredImage
        ? proj.data.featuredImage.startsWith('http')
          ? proj.data.featuredImage
          : `${site.url}${proj.data.featuredImage}`
        : undefined,
    })),
  },
};
---

<BaseLayout
  title={`Portfolio & Selected Work — ${site.name}`}
  description="Selected personal, professional, and collaborative projects by Akash Thirumal across performance marketing, social media, graphic design, video editing, and website projects."
  canonical={`${site.url}/portfolio/`}
  schema={portfolioSchema}
>
  <section class="page-header">
    <div class="wrap">
      <Breadcrumbs items={breadcrumbs} />
      <span class="eyebrow">Selected Work</span>
      <h1>My <span style="color:var(--accent);">Portfolio</span></h1>
      <p class="section-sub">A structured showcase of my personal projects, professional contributions, and collaborative work across five core categories.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <!-- Filter Row -->
      <div class="reveal" style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:48px;" id="filter-buttons">
        {categories.map((cat, i) => (
          <button
            type="button"
            class:list={['soft-tag sm', { active: i === 0 }]}
            data-filter={cat}
            style={`cursor:pointer;background:${i === 0 ? 'var(--accent)' : 'transparent'};color:${i === 0 ? '#000' : 'var(--text-2)'};font-weight:${i === 0 ? '600' : 'normal'};border-color:${i === 0 ? 'var(--accent)' : 'var(--border)'};`}
          >
            {cat}
          </button>
        ))}
      </div>

      <div class="projects-grid" id="portfolio-grid">
        {allProjects.map((project) => (
          <div class="portfolio-item" data-category={project.data.category}>
            <ProjectCard
              title={project.data.title}
              category={`${project.data.projectType} • ${project.data.category}`}
              year={project.data.year}
              slug={project.slug}
              gradientFrom={project.data.gradientFrom}
              gradientTo={project.data.gradientTo}
              featuredImage={project.data.featuredImage}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section" style="background:var(--bg-2);">
    <div class="wrap" style="text-align:center;">
      <span class="eyebrow reveal">Connect</span>
      <h2 class="reveal" style="margin:16px 0 20px;">Interested in Working Together?</h2>
      <p class="reveal" style="color:var(--text-2);max-width:540px;margin:0 auto 36px;">If you'd like to talk about any of these projects or discuss a role or collaboration, feel free to reach out.</p>
      <a href="/contact/" class="btn primary magnetic reveal" data-track="book_call_click" data-track-location="portfolio_bottom">
        Let's Connect <span class="arrow">→</span>
      </a>
    </div>
  </section>

  <script is:inline>
    (function () {
      const buttons = document.querySelectorAll('#filter-buttons button');
      const items = document.querySelectorAll('#portfolio-grid .portfolio-item');

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          const filter = btn.getAttribute('data-filter');

          buttons.forEach(function (b) {
            b.classList.remove('active');
            b.style.background = 'transparent';
            b.style.color = 'var(--text-2)';
            b.style.fontWeight = 'normal';
            b.style.borderColor = 'var(--border)';
          });
          btn.classList.add('active');
          btn.style.background = 'var(--accent)';
          btn.style.color = '#000';
          btn.style.fontWeight = '600';
          btn.style.borderColor = 'var(--accent)';

          items.forEach(function (item) {
            const cat = item.getAttribute('data-category');
            if (filter === 'All' || cat === filter) {
              item.style.display = 'block';
            } else {
              item.style.display = 'none';
            }
          });
        });
      });
    })();
  </script>
</BaseLayout>
